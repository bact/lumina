## nginx config template for the standalone single-container image.
## __PORT__ is replaced at container start by start.sh using $PORT
## (Cloud Run injects PORT=8080; default is 7860 for HF Spaces / local testing).

server {
    listen __PORT__ default_server;
    server_name _;

    root /app/frontend;
    index index.html;

    # Static frontend. The router is state-based (no deep-link URLs), so an
    # unknown path is a real 404 — same behaviour as proxy/prod.conf.
    location / {
        try_files $uri $uri/ =404;
    }

    # API proxy — long timeout for SBOM generation jobs (a clone may take up to 10 min)
    location /api/ {
        # Large SBOMs are normal. Keep this above LUMINA_MAX_SBOM_BYTES (100 MiB):
        # it limits the whole request, framing included. nginx's own
        # default, 1m, refuses real SBOMs.
        client_max_body_size 101m;
        proxy_pass         http://127.0.0.1:8000/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 600s;
    }
}
