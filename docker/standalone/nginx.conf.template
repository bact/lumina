## nginx config template for the standalone single-container image.
## __PORT__ is replaced at container start by start.sh using $PORT
## (Cloud Run injects PORT=8080; default is 7860 for HF Spaces / local testing).

server {
    listen __PORT__ default_server;
    server_name _;

    root /app/frontend;
    index index.html;

    # Static frontend
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API proxy — long timeout for SBOM generation jobs (up to ~3 min clone)
    location /api/ {
        proxy_pass         http://127.0.0.1:8000/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 600s;
    }
}
