# Build context is the project root; keep noise out of the daemon.

.git
.gitignore
.dockerignore

# Editor / IDE
.claude
.vscode
.idea
*.swp
.DS_Store

# Python caches
**/__pycache__
**/*.py[codz]
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.venv

# Node (the image build uses none)
**/node_modules

# Docs and meta (not needed in any image)
working-docs
README.md
AGENTS.md
LICENSE
**/readme.md

# Compose overrides (host-only)
docker-compose.override.yml
