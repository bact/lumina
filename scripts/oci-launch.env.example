#
# Config for oci-launch.sh. Copy this file to `oci-launch.env` (which is
# gitignored) and fill in your account-specific values. NEVER commit real
# OCIDs. See INSTALL.md step 3 for the `oci ...` commands that print them.

# Compartment or tenancy OCID
COMP="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public subnet OCID
SUBNET="ocid1.subnet.oc1.<region>.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Ubuntu 24.04 aarch64 image OCID (for your region)
IMAGE="ocid1.image.oc1.<region>.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Full availability-domain name(s); drop the ones your region/tenancy lacks.
ADS=("XXXX:REGION-AD-1")

# Optional: shape size (within Always Free, max 4 OCPU / 24 GB total).
# OCPUS=1
# MEMORY_GB=6
